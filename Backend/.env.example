DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
JWT_SECRET="generate_a_long_random_string_here"
PORT=3000
NODE_ENV=production

# Seed Configuration (Required for first run)
SEED_EMPRESA_NOME="Sua Empresa"
SEED_ADMIN_EMAIL="admin@email.com"
SEED_ADMIN_PASSWORD="ChooseAStrongPassword"
SEED_INVITE_CODE="YOUR-INVITE-CODE"
SEED_INVITE_EXPIRES_AT="2099-01-01T00:00:00.000Z"

# Fake Data Configuration (Disable for Production)
ENABLE_FAKE_DATA=false
FAKE_DATA_VOLUME=0
